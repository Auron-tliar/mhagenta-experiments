(define (domain crafter-bdi)
  (:requirements :strips :typing :negative-preconditions :fluents)
  (:types
    location direction material achievement - object
    cell known-cell target station - location
    station-site - cell)
  (:constants
    left right up down - direction
    water grass stone path sand tree lava coal iron diamond table furnace impassable - material
    collect-wood collect-drink eat-plant eat-cow place-table make-wood-pickaxe
    collect-stone make-stone-pickaxe collect-coal collect-iron place-furnace
    make-iron-pickaxe collect-diamond - achievement
  )
  (:predicates
    (alive)
    (at ?cell - cell)
    (facing ?direction - direction)
    (known ?cell - location)
    (terrain ?cell - location ?material - material)
    (clear ?cell - location)
    (safe-to-enter ?cell - location)
    (movement-blocked ?cell - location)
    (adjacent ?from - cell ?to - location ?direction - direction)
    (nearby ?from - cell ?to - location)
    (ripe-plant ?cell - target)
    (cow-at ?cell - target)
    (cow-unhurt ?cell - target)
    (cow-hit-once ?cell - target)
    (cow-hit-twice ?cell - target)
    (achieved ?achievement - achievement)
    (food-restored)
    (drink-restored)
    (table-established)
    (furnace-established)
    (future-station-layout ?craft - cell ?table ?furnace - station-site)
    (coupled-furnace-site ?craft - cell ?furnace - station-site
      ?table - station)
  )
  (:functions
    (wood)
    (stone-count)
    (coal-count)
    (iron-count)
    (diamond-count)
    (wood-pickaxe)
    (stone-pickaxe)
    (iron-pickaxe)
    (total-cost)
  )

  (:action walk-left
    :parameters (?from ?to - cell)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to left) (safe-to-enter ?to))
    :effect (and (not (at ?from)) (at ?to) (facing left)
      (not (facing right)) (not (facing up)) (not (facing down))
      (increase (total-cost) 1)))
  (:action walk-right
    :parameters (?from ?to - cell)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to right) (safe-to-enter ?to))
    :effect (and (not (at ?from)) (at ?to) (facing right)
      (not (facing left)) (not (facing up)) (not (facing down))
      (increase (total-cost) 1)))
  (:action walk-up
    :parameters (?from ?to - cell)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to up) (safe-to-enter ?to))
    :effect (and (not (at ?from)) (at ?to) (facing up)
      (not (facing left)) (not (facing right)) (not (facing down))
      (increase (total-cost) 1)))
  (:action walk-down
    :parameters (?from ?to - cell)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to down) (safe-to-enter ?to))
    :effect (and (not (at ?from)) (at ?to) (facing down)
      (not (facing left)) (not (facing right)) (not (facing up))
      (increase (total-cost) 1)))

  (:action turn-left
    :parameters (?from - cell ?to - location)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to left)
      (movement-blocked ?to) (not (facing left)))
    :effect (and (facing left) (not (facing right)) (not (facing up))
      (not (facing down)) (increase (total-cost) 1)))
  (:action turn-right
    :parameters (?from - cell ?to - location)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to right)
      (movement-blocked ?to) (not (facing right)))
    :effect (and (facing right) (not (facing left)) (not (facing up))
      (not (facing down)) (increase (total-cost) 1)))
  (:action turn-up
    :parameters (?from - cell ?to - location)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to up)
      (movement-blocked ?to) (not (facing up)))
    :effect (and (facing up) (not (facing left)) (not (facing right))
      (not (facing down)) (increase (total-cost) 1)))
  (:action turn-down
    :parameters (?from - cell ?to - location)
    :precondition (and (alive) (at ?from) (adjacent ?from ?to down)
      (movement-blocked ?to) (not (facing down)))
    :effect (and (facing down) (not (facing left)) (not (facing right))
      (not (facing up)) (increase (total-cost) 1)))

  (:action do-tree
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (terrain ?target tree) (clear ?target))
    :effect (and (not (terrain ?target tree)) (terrain ?target grass)
      (not (movement-blocked ?target)) (safe-to-enter ?target)
      (increase (wood) 1) (achieved collect-wood) (increase (total-cost) 1)))
  (:action do-water
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (terrain ?target water) (clear ?target))
    :effect (and (achieved collect-drink) (drink-restored)
      (increase (total-cost) 1)))
  (:action do-ripe-plant
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (ripe-plant ?target))
    :effect (and (not (ripe-plant ?target)) (achieved eat-plant)
      (food-restored) (increase (total-cost) 1)))

  (:action hit-cow-unhurt
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (cow-at ?target) (cow-unhurt ?target))
    :effect (and (not (cow-unhurt ?target)) (cow-hit-once ?target)
      (increase (total-cost) 1)))
  (:action hit-cow-once
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (cow-at ?target) (cow-hit-once ?target))
    :effect (and (not (cow-hit-once ?target)) (cow-hit-twice ?target)
      (increase (total-cost) 1)))
  (:action finish-cow
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (cow-at ?target) (cow-hit-twice ?target))
    :effect (and (not (cow-at ?target)) (not (cow-hit-twice ?target))
      (not (movement-blocked ?target)) (clear ?target) (safe-to-enter ?target)
      (achieved eat-cow) (food-restored) (increase (total-cost) 1)))

  (:action place-table-op
    :parameters (?from - cell ?target ?future-furnace - station-site
      ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction)
      (future-station-layout ?from ?target ?future-furnace)
      (safe-to-enter ?target) (>= (wood) 2))
    :effect (and (decrease (wood) 2) (not (terrain ?target grass))
      (not (terrain ?target path)) (not (terrain ?target sand))
      (terrain ?target table) (not (safe-to-enter ?target))
      (movement-blocked ?target) (table-established) (achieved place-table)
      (increase (total-cost) 1)))
  (:action make-wood-pickaxe-op
    :parameters (?location - cell ?table - station)
    :precondition (and (alive) (at ?location) (nearby ?location ?table)
      (terrain ?table table) (>= (wood) 1))
    :effect (and (decrease (wood) 1) (increase (wood-pickaxe) 1)
      (achieved make-wood-pickaxe) (increase (total-cost) 1)))
  (:action do-stone
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (terrain ?target stone)
      (clear ?target) (>= (wood-pickaxe) 1))
    :effect (and (not (terrain ?target stone)) (terrain ?target path)
      (not (movement-blocked ?target)) (safe-to-enter ?target)
      (increase (stone-count) 1) (achieved collect-stone)
      (increase (total-cost) 1)))
  (:action make-stone-pickaxe-op
    :parameters (?location - cell ?table - station)
    :precondition (and (alive) (at ?location) (nearby ?location ?table)
      (terrain ?table table) (>= (wood) 1) (>= (stone-count) 1))
    :effect (and (decrease (wood) 1) (decrease (stone-count) 1)
      (increase (stone-pickaxe) 1) (achieved make-stone-pickaxe)
      (increase (total-cost) 1)))
  (:action do-coal
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (terrain ?target coal)
      (clear ?target) (>= (wood-pickaxe) 1))
    :effect (and (not (terrain ?target coal)) (terrain ?target path)
      (not (movement-blocked ?target)) (safe-to-enter ?target)
      (increase (coal-count) 1) (achieved collect-coal)
      (increase (total-cost) 1)))
  (:action do-iron
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (terrain ?target iron)
      (clear ?target) (>= (stone-pickaxe) 1))
    :effect (and (not (terrain ?target iron)) (terrain ?target path)
      (not (movement-blocked ?target)) (safe-to-enter ?target)
      (increase (iron-count) 1) (achieved collect-iron)
      (increase (total-cost) 1)))
  (:action place-furnace-op
    :parameters (?from - cell ?target - station-site ?table - station
      ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction)
      (coupled-furnace-site ?from ?target ?table)
      (safe-to-enter ?target)
      (terrain ?table table) (>= (stone-count) 4))
    :effect (and (decrease (stone-count) 4)
      (not (terrain ?target grass)) (not (terrain ?target path))
      (not (terrain ?target sand)) (terrain ?target furnace)
      (not (safe-to-enter ?target)) (movement-blocked ?target)
      (furnace-established) (achieved place-furnace)
      (increase (total-cost) 1)))
  (:action make-iron-pickaxe-op
    :parameters (?location - cell ?table ?furnace - station)
    :precondition (and (alive) (at ?location)
      (nearby ?location ?table) (nearby ?location ?furnace)
      (terrain ?table table) (terrain ?furnace furnace)
      (>= (wood) 1) (>= (coal-count) 1) (>= (iron-count) 1))
    :effect (and (decrease (wood) 1) (decrease (coal-count) 1)
      (decrease (iron-count) 1) (increase (iron-pickaxe) 1)
      (achieved make-iron-pickaxe) (increase (total-cost) 1)))
  (:action do-diamond
    :parameters (?from - cell ?target - target ?direction - direction)
    :precondition (and (alive) (at ?from) (facing ?direction)
      (adjacent ?from ?target ?direction) (terrain ?target diamond)
      (clear ?target) (>= (iron-pickaxe) 1))
    :effect (and (not (terrain ?target diamond)) (terrain ?target path)
      (not (movement-blocked ?target)) (safe-to-enter ?target)
      (increase (diamond-count) 1) (achieved collect-diamond)
      (increase (total-cost) 1)))
)
